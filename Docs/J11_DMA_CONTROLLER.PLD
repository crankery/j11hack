AL14.CK = AL13;
AL14.K = 'b'0;
LA14 = AL14;
AL14.AR = !(LOAD & MUX14);

MUX15 = !(LOAD & ((A15 & RS0) # (DMA7 & RS2)));
AL15.AP = MUX15;
AL15.J = 'b'0;
